# Kopiera till backend/.env. Samma fil lokalt och i produktion, där
# compose.prod.yaml monterar in den i containern.

# anthropic (default) eller openai.
AI_PROVIDER=anthropic

# Bara nyckeln för leverantören ovan behöver fyllas i.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Konton, numrera vidare för fler: APP_AUTH_USERS_1_USERNAME osv.
# Användarnamnet blir katalognamn för användarens data: 3-32 tecken, gemener,
# siffror, - och _.
APP_AUTH_USERS_0_USERNAME=

# BCrypt-hash, se DEPLOY.md för kommandot. Klistra in som den skrivs ut: inga
# citattecken, de strippas inte och ger "fel lösenord" vid inloggning. Filen
# läses som en properties-fil, så "export" framför raden fungerar inte heller.
APP_AUTH_USERS_0_PASSWORDHASH=

# COOKIE_SECURE och APP_STORAGE_BASE_DIR sätts av compose.prod.yaml och ska
# inte stå här. Miljövariablerna därifrån vinner över den här filen, men en
# rad här som skiljer sig från prod förvirrar bara.
