# Kopiera till backend/.env och fyll i. Samma fil används lokalt och i
# produktion - i produktion monteras den in i backend-containern av
# compose.prod.yaml. Den är gitignorerad och ska aldrig committas.

# Vilken AI-leverantör som används: anthropic (default) eller openai.
AI_PROVIDER=anthropic

# API-nyckel för den leverantör du valt ovan. Bara den ena behöver fyllas i.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Konton. Numrera vidare för fler: APP_AUTH_USERS_1_USERNAME osv.
# Användarnamnet blir också katalognamn för användarens data: 3-32 tecken,
# gemener, siffror, - och _.
APP_AUTH_USERS_0_USERNAME=

# BCrypt-hash med {bcrypt}-prefix, se DEPLOY.md för kommandot som skapar den.
# Klistra in den precis som den skrivs ut: inga citattecken, och rör inte
# $-tecknen. Docker Compose läser aldrig den här filen - den monteras som fil
# - så $ betyder ingenting här. (Hade hashen gått via compose environment:
# eller env_file hade $2a$10$... kapats till $2a$10 och inloggningen slutat
# fungera utan att något felmeddelande antytt varför.)
APP_AUTH_USERS_0_PASSWORDHASH=

# COOKIE_SECURE och APP_STORAGE_BASE_DIR sätts av compose.prod.yaml i
# produktion och ska inte stå här - står de här vinner de, och resultatet blir
# en sessionscookie i klartext respektive användardata utanför den persistenta
# volymen. Lokalt behövs de inte alls.
