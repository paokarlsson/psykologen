# Kopiera till .env på servern. Den här filen läses av Docker Compose och
# innehåller bara det Caddy behöver. Appens hemligheter - API-nyckel och konton
# - ligger i backend/.env, se backend/.env.example.
#
# Uppdelningen är medveten: Compose tolkar $-tecken i sina egna env-filer, och
# en BCrypt-hash full av $ skulle kapas tyst. backend/.env monteras rakt in i
# containern och passerar aldrig Compose.

# Domänen appen ska svara på, t.ex. psykologen.example.se. Måste peka på
# droppens IP i DNS innan första starten, annars kan Let's Encrypt inte
# utfärda något certifikat.
DOMAIN=

# Mejladress till Let's Encrypt, för varningar om certifikat som går ut.
ACME_EMAIL=
